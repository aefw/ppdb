defined('BASEPATH') OR exit('No direct script access allowed');

/**
 * Perubahan pada file ini maka diperlukan penyesuaian juga dengan file yg seirama dengan ini
 * file yg seirama dengan file ini adalah:
 * /app/modules/finance/libraries/api_xendit*
 * ppdb/app/modules/finance/libraries/api_xendit*
 * sia/app/modules/sch_fa_siswa/libraries/api_xendit*
 * siska/app/modules/sch_fa_siswa/libraries/api_xendit*
